# =============================================================
# EXOTIC JOYERÍA — Variables de Entorno
# =============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =============================================================

# Supabase — Obtén estos valores en https://supabase.com/dashboard
# → Proyecto → Settings → API
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key-publica"

# Cloudflare Turnstile (clave pública del sitio; la clave secreta va SOLO en Supabase → Authentication → Attack Protection)
VITE_TURNSTILE_SITE_KEY=""
